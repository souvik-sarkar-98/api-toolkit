# Scoped packages publish to / install from the public npm registry (no token for install).
# Publisher: run `npm login` once (needs access to the @ssdev-toolkit org on npmjs.com).
@ssdev-toolkit:registry=https://registry.npmjs.org/

# Previous private GitHub Packages setup (keep for reference):
# @ssdev-toolkit:registry=https://npm.pkg.github.com
# //npm.pkg.github.com/:_authToken=${NPM_TOKEN}
# always-auth=true
